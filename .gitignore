# ========================================
# Flutter 官方标准忽略规则（安全 + 可构建）
# ========================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
build/
.pub-cache/
**/doc/api/
**/ios/Flutter/.last_build_id

# Generated by Flutter
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.swift

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# ========================================
# Android 相关忽略规则（安全）
# ========================================

# Android build outputs
android/app/debug/
android/app/profile/
android/app/release/
android/app/build/

# Gradle cache & local env
android/.gradle/
android/local.properties

# Keystore & signing
android/key.properties
android/*.keystore
android/app/*.keystore
android/*.jks
android/app/*.jks

# NDK
android/.cxx/

# ========================================
# iOS/macOS 相关忽略规则
# ========================================

ios/Flutter/.last_build_id
ios/.generated/
macos/Flutter/ephemeral/
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
# Xcode
*.xcworkspace/
*.xcuserstate
*.xcuserdatad/
*.xcuserdata/
