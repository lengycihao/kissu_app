# ========================================
# 自定义规则：只跟踪指定的文件和目录
# ========================================

# 1. 忽略根目录下所有文件和目录
/*

# 2. 取消忽略需要跟踪的目录和文件
!.gitignore

# lib 目录
!lib/

# plugins 目录
!plugins/

# assets 目录
!assets/

# yaml 配置文件
!*.yaml

# android/app/src/main 目录（需要逐层取消忽略）
!android/
android/*
!android/app/
android/app/*
!android/app/src/
android/app/src/*
!android/app/src/main/

# ========================================
# 标准 Flutter 忽略规则
# ========================================

# # Miscellaneous
# *.class
# *.log
# *.pyc
# *.swp
# .DS_Store
# .atom/
# .build/
# .buildlog/
# .history
# .svn/
# .swiftpm/
# migrate_working_dir/

# # IntelliJ related
# *.iml
# *.ipr
# *.iws
# .idea/

# # Flutter/Dart/Pub related
# **/doc/api/
# **/ios/Flutter/.last_build_id
# .dart_tool/
# .flutter-plugins
# .flutter-plugins-dependencies
# .pub-cache/
# .pub/
# build/

# # Symbolication related
# app.*.symbols

# # Obfuscation related
# app.*.map.json

# Android build artifacts
android/app/debug/
android/app/profile/
android/app/release/
android/app/build/

# # Local configuration files (contain sensitive data)
# android/local.properties
# android/key.properties
# android/*.keystore
# android/app/*.keystore
