<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 允许开发环境的HTTP访问 -->
        <domain includeSubdomains="true">devweb.ikissu.cn</domain>
        <domain includeSubdomains="true">ikissu.cn</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- 测试服务器 IP -->
        <domain includeSubdomains="true">129.204.154.113</domain>
    </domain-config>
    
    <!-- 高德地图SDK域名配置 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">amap.com</domain>
        <domain includeSubdomains="true">autonavi.com</domain>
        <domain includeSubdomains="true">alibaba.com</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    
    <!-- 生产环境建议使用HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
